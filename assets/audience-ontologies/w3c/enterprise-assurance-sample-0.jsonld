"]},{"field":"business_functions","values":["Compliance and justice"]}]],"scenarioId":"scenario-biometric","controlIds":["control-fairness"]},{"id":"worker-context","label":"노동자·인사 영향 검토","any":[[{"field":"harmed_entities","values":["Workers","Trade unions"]},{"field":"business_functions","values":["Human resource management"]}]],"scenarioId":"scenario-automation-work","controlIds":["control-privacy","control-oversight"]},{"id":"education-context","label":"교육 콘텐츠·평가 용도 확인","any":[[{"field":"industries","values":["Education and training"]},{"field":"ai_tasks","values":["Content generation","Forecasting/prediction"]}]],"none":[{"field":"business_functions","values":["Human resource management"]},{"field":"harmed_entities","values":["Workers","Trade unions"]}],"scenarioId":"scenario-education-assessment"},{"id":"generated-deception-context","label":"합성 콘텐츠의 기만·진위 확인","any":[[{"field":"ai_tasks","values":["Content generation"]},{"field":"industries","values":["Mobility and autonomous vehicles","Media, social platforms, and marketing","Consumer services"]},{"field":"harm_types","values":["Economic/Property","Reputational","Public interest"]}]],"scenarioId":"scenario-deepfake"},{"id":"public-information-context","label":"미디어 추천의 공적 영향 검토","any":[[{"field":"industries","values":["Media, social platforms, and marketing"]},{"field":"ai_tasks","values":["Organisation/recommenders"]}]],"scenarioId":"scenario-public-information"},{"id":"health-context","label":"의료 예측·인식 작업 검토","any":[[{"field":"industries","values":["Healthcare, drugs, and biotechnology"]},{"field":"ai_tasks","values":["Forecasting/prediction","Recognition/object detection"]}]],"scenarioId":"scenario-health"}],"sectorMap":{"Digital security":["Digital Economy"],"IT infrastructure and hosting":["Digital Economy"],"Financial and insurance services":["Finance and insurance"],"Healthcare, drugs, and biotechnology":["Health"],"Mobility and autonomous vehicles":["Transport"],"Logistics, wholesale, and retail":["Trans